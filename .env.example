API_ID=
API_HASH=
BOT_TOKEN=
# YouTube is temporarily available only to this numeric Telegram user ID.
# Empty disables YouTube for everyone; group admins do not gain access.
MAIN_ADMIN_ID=
# Set fixed host ports, or let setup_services.py select and save free ports once.
POSTGRES_PORT=
POSTGRES_POOL_SIZE=32
REDIS_PORT=
# Optional: Python builds localhost URLs from the ports and DEV_DB_PASSWORD at startup.
# Explicit URLs are used only when the corresponding port above is blank.
DATABASE_URL=
REDIS_URL=
# Optional independent evictable cache endpoint. Conversation state stays durable in PostgreSQL.
REDIS_CACHE_URL=
# PostgreSQL's Docker container reads this password from .env.
DEV_DB_PASSWORD=YOUR_PASSWORD
# Use ffmpeg on PATH or an absolute executable path.
FFMPEG_PATH=
TRANSFER_CONCURRENCY=1000
# Total deadline, including waiting for extraction/remux; adjust for aggregate bandwidth.
TRANSFER_TIMEOUT_SECONDS=3600
CACHED_TRANSFER_CONCURRENCY=1000
METADATA_CONCURRENCY=8
# Concurrent FFmpeg processes; remux runs in subprocesses, never in the event loop.
REMUX_CONCURRENCY=2
# In-flight 512 KiB parts per upload, bounded to 1..8.
UPLOAD_PARALLELISM=4
# Global window for parts being filled or uploaded (64 * 512 KiB = 32 MiB, plus read/transport buffers).
UPLOAD_INFLIGHT_PARTS=64
TELEGRAM_SENDS_PER_SECOND=0
# Optional: a Telegram storage channel accessible to this bot, e.g. @channel_username.
MEDIA_STORAGE_CHAT=
# Optional authorized SoundCloud account token; public tracks work without it.
SOUNDCLOUD_OAUTH_TOKEN=
# Additional tokens are referenced by site_accounts.credential_env.
SOUNDCLOUD_ACCOUNT_1_TOKEN=
SOUNDCLOUD_ACCOUNT_2_TOKEN=
# Optional authorized Instagram browser Cookie header, on one line. Never put it in source.
INSTAGRAM_COOKIE=
# Optional HTTP proxy used by this provider for extraction, samples and full delivery.
INSTAGRAM_PROXY=
# Optional network diagnostics/profile. Defaults keep the existing transport.
# DNS-over-HTTPS and HTTP/3 do not grant access to rejected/private posts.
INSTAGRAM_DOH_URL=
INSTAGRAM_HTTP_VERSION=auto
# Anonymous public-post fallback. Only a canonical public URL is sent, never cookies.
# Set empty to disable or use your own compatible Cobalt endpoint.
INSTAGRAM_RESOLVER_URL=https://dwnld.nichind.dev
# Guest native budget before public-post fallback (1-35 seconds); no effect on stories/accounts.
INSTAGRAM_NATIVE_TIMEOUT_SECONDS=8
# Additional accounts can use site_accounts.credential_env, with site='instagram'.
INSTAGRAM_ACCOUNT_1_COOKIE=
# Override only when Instagram changes its persisted GraphQL queries.
INSTAGRAM_ROOT_DOC_ID=27130156389949648
INSTAGRAM_SHORTCODE_DOC_ID=27128499623469141
INSTAGRAM_WEB_DOC_ID=27830990013244856
# Public TikTok metadata, with HD/video/photo/music choices in one request.
# Empty disables the resolver and uses native TikTok public-page extraction only.
TIKTOK_RESOLVER_URL=https://www.tikwm.com/api/
# Per-method metadata budget, including queue waits (1-20 seconds).
TIKTOK_METADATA_TIMEOUT_SECONDS=6
# Optional native/CDN HTTP proxy; no account cookies are sent to the resolver.
TIKTOK_PROXY=
# Install Node >=22 or Deno >=2.3 on the host for YouTube's EJS solver.
YOUTUBE_JS_RUNTIME=node
# Optional authorized Netscape cookie file (path INSIDE the bot's runtime).
YOUTUBE_COOKIES_FILE=
# Optional HTTP proxy. Empty uses a direct connection consistently for extraction/delivery.
YOUTUBE_PROXY=
# Anonymous public converter fallback after native guest failure; empty disables it.
# Sends only the canonical video URL, without account cookies or an API credential.
YOUTUBE_RESOLVER_URL=https://cnv.cx
# Guest native worker budget before public fallback (1-45 seconds).
YOUTUBE_NATIVE_TIMEOUT_SECONDS=8
# Reuse only a complete verified guest quality catalog; source URLs still expire independently.
# 0 disables this cache; range 0..900 seconds. Callbacks refresh the selected source as needed.
YOUTUBE_CATALOG_TTL_SECONDS=300
# Optional HTTPS JSON DNS resolver for locally filtered DNS; explicit proxy wins.
# Example: https://dns.google/resolve. Empty leaves DNS unchanged.
YOUTUBE_DOH_URL=
# Empty follows yt-dlp defaults, or selects mweb,web_safari when a POT helper is configured.
YOUTUBE_PLAYER_CLIENTS=
# Optional separately configured token helper reachable from the host.
YOUTUBE_POT_BASE_URL=
# Request interval is seconds; MAX_FILE_SIZE_MB uses 1024*1024 bytes.
# No per-user turn scheduling. Explicit Telegram FloodWait is still honored.
MAX_CONCURRENT_REQUESTS=1000
USER_REQUEST_INTERVAL_SECONDS=60
# Shared rolling 60-second quota for each group, in addition to the per-user interval.
GROUP_LINKS_PER_MINUTE=5
MAX_FILE_SIZE_MB=1024
# JSON performance events; an empty LOG_FILE disables file output.
LOG_FILE=logs/performance.jsonl
LOG_MAX_MB=20
LOG_BACKUP_COUNT=10
LOG_QUEUE_SIZE=10000
LOG_STDOUT=1
METRICS_INTERVAL_SECONDS=30
# Empty samples all non-loopback interfaces; set the host interface to narrow the scope.
METRICS_NETWORK_INTERFACE=
# Account-scoped Telegram session files survive restarts and must stay private.
SESSION_NAME=.runtime/sessions/saintcrispy
# Primary pack or comma-separated names/URLs; the 13 curated packs are included automatically.
# Empty disables all custom emojis. Unicode fallback works without Premium privileges.
CUSTOM_EMOJI_SET=IconsEmoji
